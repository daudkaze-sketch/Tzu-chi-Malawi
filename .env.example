# Database Configuration
# For development, use SQLite (file:./prisma/dev.db)
# For production, use PostgreSQL or other service
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-key-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# JWT Token Secret
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-key-generate-randomly"

# Optional: For production database services
# DATABASE_URL="postgresql://user:password@db.example.com:5432/tzuchidb"

# Optional: Email service (future feature)
# NEXTAUTH_EMAIL_FROM="noreply@tzuchioffice.com"
# SENDGRID_API_KEY="your-sendgrid-key"

# Optional: File upload service (future feature)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"

# Node environment
NODE_ENV="development"

# ----- Vercel deployment guide (placeholders) -----
# Copy values below into Vercel project Settings → Environment Variables
# - Set these for both Preview and Production as needed
# Example production values:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# NEXTAUTH_SECRET="generate_a_long_secret_here"
# NEXTAUTH_URL="https://your-site.vercel.app"

# Optional provider keys (only set if you use them in production):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# CLERK_FRONTEND_API, CLERK_API_KEY
# S3_BUCKET_NAME, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY

# IMPORTANT: Never commit real secrets to the repository. Use Vercel's Environment
# Variables UI to store production secrets securely.
